# Copy to .env for local development. Replace all placeholders locally; do not commit .env.
NODE_ENV=development
WEB_PORT=8080
API_PORT=3000
MYSQL_PUBLISH_PORT=3307

# For direct Node development use 127.0.0.1; Compose overrides this to mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=c12_internalapp
MYSQL_USER=c12_app
MYSQL_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_POOL_SIZE=10

# Generate a random signing key locally before auth is enabled.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false

# Path only; the admin password itself is stored in a local Docker secret file.
# Compose will mount this as /run/secrets/admin_password.
ADMIN_PASSWORD_FILE=./secrets/admin_password
FILE_STORAGE_DIR=./storage/uploads
TRUST_PROXY=false
TZ=Asia/Ho_Chi_Minh
